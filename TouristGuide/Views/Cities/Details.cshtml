@model TouristGuide.Models.City
@{
    ViewData["Title"] = Model.Name;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-link px-0">&larr; Назад к списку городов</a>
</div>

<div class="card shadow-sm mb-4">
        <img src="@Model.ImageUrl"
            class="card-img-top"
            alt="@Model.Name"
            style="max-height: 420px; object-fit: cover;"
            onerror="this.onerror=null;this.src='/images/photo-placeholder.svg';" />
    <div class="card-body">
        <h1>@Model.Name</h1>
        <p class="mb-1"><strong>Регион:</strong> @Model.Region</p>
        <p class="mb-1"><strong>Население:</strong> @Model.Population.ToString("N0")</p>
        <p class="mb-3"><strong>История:</strong> @Model.History</p>
        <div>
            <p class="mb-1"><strong>Герб:</strong></p>
              <img src="@Model.CoatOfArmsUrl"
                  alt="Герб города @Model.Name"
                  style="max-height: 170px; width: auto;"
                  onerror="this.onerror=null;this.src='/images/coat-placeholder.svg';" />
        </div>
    </div>
</div>

<h2 class="mb-3">Достопримечательности</h2>

@if (!Model.Attractions.Any())
{
    <div class="alert alert-info">Для этого города пока нет достопримечательностей.</div>
}
else
{
    <div class="row g-4">
        @foreach (var attraction in Model.Attractions.OrderBy(item => item.Name))
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 shadow-sm">
                    <img src="@attraction.ImageUrl"
                        class="card-img-top"
                        alt="@attraction.Name"
                        style="height: 200px; object-fit: cover;"
                        onerror="this.onerror=null;this.src='/images/photo-placeholder.svg';" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@attraction.Name</h5>
                        <p class="text-muted flex-grow-1">@attraction.ShortDescription</p>
                        <a asp-controller="Attractions" asp-action="Details" asp-route-id="@attraction.Id" class="btn btn-outline-primary mt-2">Открыть страницу достопримечательности</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
